<?xml version="1.0" encoding="UTF-8"?>
<!--
    The test suffix is not PHPUnit's default "Test.php", so that the
    PHPUnit run of scip-php itself does not pick up these test fixtures.
-->
<phpunit>
    <testsuites>
        <testsuite name="tests">
            <directory suffix="Tests.php">tests</directory>
            <directory suffix="Tests.php">src</directory>
        </testsuite>
    </testsuites>
</phpunit>
